{% template mountain %}
{% assign qr_url = '' %}
{% if allow_feedback %}
  {% assign qr_url = feedback_url | default: '' %}
  {% if qr_url == '' and feedback_qr_path %}
    {% assign feedback_page = feedback_qr_path | replace: '/q/', '/f/' %}
    {% assign qr_url = image_origin | append: feedback_page %}
  {% endif %}
{% endif %}
<div class="flex flex--col w--full h--full gap--small relative">
  <div class="grow w--full h--min-0">
{% assign state = status | default: 'unknown' %}
<svg class="w--full h--full" viewBox="0 0 736 300" role="img" aria-label="Illustrated mountain visibility estimate: {{ state | escape }}. Cloud positions are symbolic.">
  {% unless state == 'unknown' %}
  <image href="{{ image_origin | escape }}{{ image_path | default: '/assets/rainier-seattle.png' | escape }}" x="0" y="0" width="736" height="300" preserveAspectRatio="xMidYMid meet" />
  {% endunless %}
  {% case state %}
  {% when 'mostly_out' %}{% assign cloud_y = 175 %}
  {% when 'halfway_out' %}{% assign cloud_y = 90 %}
  {% when 'kinda_out' %}{% assign cloud_y = 20 %}
  {% when 'not_out' %}{% assign cloud_y = -60 %}
  {% endcase %}
  {% if state == 'mostly_out' or state == 'halfway_out' or state == 'kinda_out' or state == 'not_out' %}
  <!-- Naturalistic ink cloud texture with an opaque white body masks the scene. -->
  <g transform="translate(0 {{ cloud_y }})">
    <rect x="0" y="180" width="736" height="320" fill="#fff"/>
    <image href="{{ image_origin | escape }}/assets/cloud-bank.png" x="0" y="0" width="736" height="250" preserveAspectRatio="none" />
  </g>
  {% elsif state == 'unknown' %}
  <!-- An unfilled dashed outline conveys missing data, without implying weather. -->
  <path d="M24 248 Q100 238 156 202 L177 187 195 201 Q247 173 287 129 Q319 91 357 86 Q393 77 426 96 Q463 118 483 148 Q540 207 612 222 L712 248" fill="none" stroke="#000" stroke-width="4" stroke-dasharray="12 10" stroke-linecap="round"/>
  {% endif %}
</svg>
  </div>
  <div class="flex flex--row flex--center-y w--full no-shrink gap--small">
    <div class="flex flex--center-x flex--center-y grow w--min-0">
      <span class="value value--large lg:value--xxlarge no-shrink" data-fit-value="true">{{ verdict | default: 'UNKNOWN' | escape }}</span>
    </div>
    {% if qr_url != '' %}
    <!-- Reserve the same native, scalable footprint as the anchored QR + label. -->
    <div class="no-shrink w--32" aria-hidden="true">
      <div class="aspect--1/1 w--full"></div>
      <span class="label label--small block">&nbsp;</span>
    </div>
    {% endif %}
  </div>
  {% if qr_url != '' %}
  <div class="absolute bottom--0 right--0 w--32 bg--white" data-feedback-qr>
    <div class="w--full p--3" aria-label="Scan to report whether the mountain is visible">
      {{ qr_url | qr_code: 1, 'l' | replace: 'class="qr-code"', 'class="qr-code w--full h--auto block"' }}
    </div>
    <span class="label label--small block text--center">Submit report</span>
  </div>
  {% endif %}
</div>
{% endtemplate %}
