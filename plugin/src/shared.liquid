{% template mountain %}
{% assign image_origin = 'https://is-the-mountain-out.5g5wqr7kzx-466.workers.dev' %}
{% assign state = status | default: 'unknown' %}
{% comment %}Verdict text is on unless the setting is explicitly off; TRMNL may send booleans or strings.{% endcomment %}
{% assign show_text = true %}
{% assign text_setting = show_verdict_text | append: '' | downcase %}
{% if text_setting == 'false' or text_setting == 'no' or text_setting == 'off' or text_setting == '0' %}{% assign show_text = false %}{% endif %}
{% if state == 'unknown' and night == 'night' %}
<!-- After sunset the view cannot be judged: a starry night sky, with the mountain dark against it, replaces the scene and verdict. -->
{% comment %}Full screen only (the one layout with feedback): the sky is fixed to the viewport so it also covers the device padding. Mashups keep their gutters.{% endcomment %}
{% comment %}Each viewpoint's ridgeline, traced from its artwork, blocks the stars where the mountain stands. It sits where the illustration would.{% endcomment %}
{% assign sky_level = 1 %}
{% case image_path %}
{% when '/assets/hood-portland.png' %}{% assign sky_level = 2 %}
{% when '/assets/rainier-tacoma.png' %}{% assign sky_level = 3 %}
{% when '/assets/rainier.png' %}{% assign sky_level = 4 %}
