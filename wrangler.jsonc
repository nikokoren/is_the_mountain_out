{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "is-the-mountain-out",
  "main": "cloudflare/src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "WEATHER_MODEL": "v2" },
  "previews": {
    "vars": { "WEATHER_MODEL": "v2" },
    // Separate test storage shared by branch previews.
    "d1_databases": [{
      "binding": "DB",
      "database_name": "mountain-feedback-preview",
      "database_id": "5bc3f900-f60f-4803-baca-892f9af58451"
    }]
  },
  "assets": {
    "directory": "assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [{ "binding": "DB", "database_name": "mountain-feedback" }],
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "triggers": { "crons": [] },
  "observability": { "enabled": false }
}
