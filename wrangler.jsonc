{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "is-the-mountain-out",
  "main": "cloudflare/src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [{ "binding": "DB", "database_name": "mountain-feedback" }],
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": false }
}
